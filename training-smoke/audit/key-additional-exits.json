{
  "full-key-fused-seq128": {
    "command": [
      "bash",
      "training-smoke/audit/launch-single.sh",
      "--full",
      "--bf16",
      "--all-gradients",
      "--reference-profile",
      "blinkdl",
      "--precision-probe",
      "key-fused",
      "--capture-output",
      "full-key-fused-seq128",
      "--result-tag=-key-fusion-seq128"
    ],
    "log": "training-smoke/logs/audit-key-fused-seq128.log",
    "exit_code": 0
  },
  "operator-formula": {
    "command": [
      "bash",
      "training-smoke/audit/launch-key-experiment.sh",
      "operator",
      "--skip-benchmark"
    ],
    "log": "training-smoke/logs/audit-key-operator-formula.log",
    "exit_code": 0
  },
  "analysis": {
    "command": [
      "/mnt/data/anaconda3/envs/train_mobius_py312/bin/python",
      "training-smoke/audit/analyze-key-experiments.py"
    ],
    "environment": {
      "OMP_NUM_THREADS": "8"
    },
    "log": "training-smoke/logs/audit-key-analysis.log",
    "exit_code": 0
  }
}
